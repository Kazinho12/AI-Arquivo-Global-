# Variáveis de ambiente públicas para o Arquivo Global
# Substituir pelos valores do teu projeto Supabase em .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_me

# Ativar apenas após instalar e validar 20261111040000_persist_cover_styles.sql
VITE_ENABLE_COVER_STYLE=false

# Ativar só após validar 20261111050000_cover_studio_v2.sql (requer COVER_STYLE=true)
VITE_ENABLE_COVER_STUDIO_V2=false

# F4.2-A: só após validar a migration custom_cover_media e o Worker existente
VITE_ENABLE_CUSTOM_COVERS=false
