{
  "name": "arquivo-global",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test scripts/*.test.ts scripts/*.test.tsx",
    "format": "prettier --write src/foundation src/main.tsx scripts vite.config.ts tsconfig.json package.json index.html vercel.json README.md VALIDATION.md docs",
    "format:check": "prettier --check src/foundation src/main.tsx scripts vite.config.ts tsconfig.json package.json index.html vercel.json README.md VALIDATION.md docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
